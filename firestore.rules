rules_version = '2';

// Default-deny skeleton. Every collection needs an explicit, narrow allow
// rule added in the phase that introduces it — nothing is implicitly open.
service cloud.firestore {
  match /databases/{database}/documents {

    // Owner-only for now (Phase 5 extends this to collaboratorIds too).
    function isProjectOwner(projectId) {
      return request.auth != null
        && request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId;
    }

    // A user may only read or write their own profile document.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;

      // email and createdAt are immutable once set; only displayName may change.
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0;

      allow delete: if false;
    }

    // Owner-only for now. Phase 5 extends read (and later write) to also
    // allow request.auth.uid in resource.data.collaboratorIds; delete
    // stays owner-only. Steps subcollection rule is added in Phase 3.
    match /projects/{projectId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerId
        && request.resource.data.keys().hasOnly(
             ['name', 'category', 'ownerId', 'collaboratorIds', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.category == 'diy'
        && request.resource.data.collaboratorIds == []
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if request.auth != null && request.auth.uid == resource.data.ownerId;

      allow update: if request.auth != null
        && request.auth.uid == resource.data.ownerId
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.collaboratorIds == resource.data.collaboratorIds
        && request.resource.data.updatedAt == request.time;

      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;

      // Same owner-only check as the parent project, via a get() lookup.
      // Phase 5 extends isProjectOwner() itself to also allow collaborators.
      match /steps/{stepId} {
        allow read: if isProjectOwner(projectId);

        allow create: if isProjectOwner(projectId)
          && request.resource.data.keys().hasOnly(
               ['title', 'notes', 'materials', 'tools', 'done', 'order', 'createdBy', 'createdAt', 'updatedAt'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.notes is string
          && request.resource.data.materials is list
          && request.resource.data.tools is list
          && request.resource.data.done == false
          && request.resource.data.order is number
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isProjectOwner(projectId)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;

        allow delete: if isProjectOwner(projectId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
