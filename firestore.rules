rules_version = '2';

// Default-deny skeleton. Every collection needs an explicit, narrow allow
// rule added in the phase that introduces it — nothing is implicitly open.
//
// Collaboration (projects/{id}/invites, projects/{id}/members below) is
// enforced entirely by these rules, with no Cloud Function — see CLAUDE.md
// > Security Principles for why, and the tradeoff this implies.
service cloud.firestore {
  match /databases/{database}/documents {

    function isProjectOwner(projectId) {
      return request.auth != null
        && request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId;
    }

    // Owner OR a redeemed member of the project. Collaborators can read and
    // add/check steps, but delete-worthy operations use isProjectOwner()
    // instead — only the owner can delete the project or its steps.
    function isProjectMember(projectId) {
      return request.auth != null
        && (isProjectOwner(projectId)
            || exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)));
    }

    function isValidUsername(username) {
      return username is string && username.matches('^[a-z][a-z0-9_]{2,19}$');
    }

    function isFriend(ownerUid, otherUid) {
      return exists(/databases/$(database)/documents/users/$(ownerUid)/friends/$(otherUid));
    }

    // True if the caller is the Education-workspace teacher that studentUid
    // is currently linked to (see users/{uid}.studentOfTeacherUid). Used to
    // grant the teacher READ-ONLY access into a linked student's own
    // Personal-workspace projects/steps — the student's data never moves,
    // this is purely a read grant. get() inside a rule is not itself
    // subject to the target doc's own rules, so this works regardless of
    // who's asking.
    function isTeacherOf(studentUid) {
      return request.auth != null
        // .get(field, null) rather than .field — an older-shape profile
        // doc (created before this feature existed) may not have this key
        // at all, and plain dot access throws instead of treating it as
        // unset (see the same fix on the users/{userId} update rule below).
        && get(/databases/$(database)/documents/users/$(studentUid)).data.get('studentOfTeacherUid', null) == request.auth.uid;
    }

    function isTeacherOfProject(projectId) {
      return isTeacherOf(get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId);
    }

    // A user may only read or write their own profile document.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(
             ['displayName', 'username', 'email', 'createdAt', 'photoURL',
              'businessWorkspaceId', 'teacherWorkspaceId', 'studentOfTeacherUid', 'studentOfWorkspaceId'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && isValidUsername(request.resource.data.username)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;

      // email and createdAt are immutable once set; displayName, username,
      // and photoURL may change (username changes are paired with a
      // usernames/{username} create+delete in the same client-side
      // writeBatch, photoURL changes with a usernames/{username} update —
      // see CLAUDE.md). businessWorkspaceId/teacherWorkspaceId may only be
      // set once each, from null (a user opens at most one Business and one
      // Education workspace) — checked by requiring the old value was null
      // whenever the new value differs from it. studentOfTeacherUid/
      // studentOfWorkspaceId are set only at signup (see the create rule
      // and the second allow-update clause below, not here) — self-update
      // can never touch them.
      allow update: if request.auth != null
        && (
          (request.auth.uid == userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                 ['displayName', 'username', 'photoURL', 'businessWorkspaceId', 'teacherWorkspaceId'])
            && request.resource.data.displayName is string
            && request.resource.data.displayName.size() > 0
            && isValidUsername(request.resource.data.username)
            // .get(field, null) rather than .field — an older-shape profile
            // doc (created before this feature existed) may not have these
            // keys at all, and plain dot access throws on a missing key
            // instead of treating it as unset.
            && (resource.data.get('businessWorkspaceId', null) == null || request.resource.data.businessWorkspaceId == resource.data.get('businessWorkspaceId', null))
            && (resource.data.get('teacherWorkspaceId', null) == null || request.resource.data.teacherWorkspaceId == resource.data.get('teacherWorkspaceId', null)))
          // The "release a student" mechanic: the teacher currently linked
          // to this student may clear (only) the two studentOf* fields on
          // the STUDENT's own doc — the entire release operation, no other
          // change to the student's data.
          || (resource.data.get('studentOfTeacherUid', null) == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentOfTeacherUid', 'studentOfWorkspaceId'])
            && request.resource.data.studentOfTeacherUid == null
            && request.resource.data.studentOfWorkspaceId == null)
        );

      // Self-delete only, used by the "delete profile" flow.
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Mutual edge, written to BOTH users' friends subcollections at once
      // (a client writeBatch) — either the QR-scan "instant add" flow or a
      // friendRequests accept does this. Either named party may create or
      // delete the edge on either side: that's what lets one client batch
      // both documents in a single call. See CLAUDE.md > Security
      // Principles for why this is safe even though it means a client
      // could skip the intended request/accept UX for username-search
      // adds — worst case is an unwanted friend entry, a one-tap
      // unfriend/block, not a privilege escalation.
      match /friends/{friendUid} {
        allow read: if request.auth != null && request.auth.uid == userId;

        allow create: if request.auth != null
          && (request.auth.uid == userId || request.auth.uid == friendUid)
          && request.resource.data.keys().hasOnly(['uid', 'username', 'displayName', 'photoURL', 'addedAt'])
          && request.resource.data.uid == friendUid
          && request.resource.data.addedAt == request.time
          && !exists(/databases/$(database)/documents/users/$(userId)/blocked/$(friendUid))
          && !exists(/databases/$(database)/documents/users/$(friendUid)/blocked/$(userId));

        allow update: if false;

        allow delete: if request.auth != null
          && (request.auth.uid == userId || request.auth.uid == friendUid);
      }

      // Pending, recipient-side inbox: userId is the recipient, the doc ID
      // is the requester's uid (so at most one pending request per pair).
      // Accepting is a client batch: delete this request + create both
      // sides of friends/{uid} above, performed by the recipient (who is
      // one of the two named parties in each write, per that rule).
      match /friendRequests/{requesterUid} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || request.auth.uid == requesterUid);

        allow create: if request.auth != null
          && request.auth.uid == requesterUid
          && requesterUid != userId
          && request.resource.data.keys().hasOnly(['username', 'displayName', 'photoURL', 'requestedAt'])
          && request.resource.data.requestedAt == request.time
          && !exists(/databases/$(database)/documents/users/$(userId)/friends/$(requesterUid))
          && !exists(/databases/$(database)/documents/users/$(userId)/blocked/$(requesterUid))
          && !exists(/databases/$(database)/documents/users/$(requesterUid)/blocked/$(userId));

        allow update: if false;

        // Recipient declines (or accepts, alongside the friends batch
        // write), requester withdraws their own pending request.
        allow delete: if request.auth != null
          && (request.auth.uid == userId || request.auth.uid == requesterUid);
      }

      // Self-only, one-directional. Checked by the friends/friendRequests
      // create rules above in both directions, so either side blocking
      // stops new requests/adds; existing edges are torn down client-side
      // in the same batch as creating this doc (both deletes are allowed
      // by the rules above since the blocker is a named party either way).
      match /blocked/{blockedUid} {
        allow read: if request.auth != null && request.auth.uid == userId;

        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['blockedAt'])
          && request.resource.data.blockedAt == request.time;

        allow update: if false;

        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // The doc ID *is* the unique, lowercase handle — same "ID as the whole
    // access-control mechanism" trick as projects/{id}/invites/{token}.
    // Firestore only routes a write here through `create` (never `update`)
    // when the doc doesn't already exist, so a taken username naturally
    // falls through to no matching rule and gets denied. Read is public
    // (not just signed-in) because signup needs to availability-check a
    // candidate username before an account exists yet; it only reveals
    // whether one exact, already-guessed handle is taken, not the full list.
    match /usernames/{username} {
      allow read: if true;

      // displayName/photoURL are denormalized copies (see CLAUDE.md >
      // Security Principles) so friend search/requests never need to read
      // another user's private users/{uid} doc.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'photoURL'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0;

      // The uid (this doc's identity) never changes via update — a
      // username change is a delete+create pair instead (see
      // users/{userId}). Update only refreshes displayName/photoURL, e.g.
      // after a profile-picture change.
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL']);

      // Frees the handle when its owner changes or deletes their username.
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Intentionally minimal per product decision: capture the signal only,
    // no read access and no processing yet — where reports go and how
    // they're handled is deferred to a later phase.
    match /reports/{reportId} {
      allow read: if false;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['reporterUid', 'reportedUid', 'reason', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reportedUid is string
        && request.resource.data.reason is string
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    // A Business or Education "profile" is a separate project workspace —
    // see CLAUDE.md > Security Principles. At most one of each per user,
    // enforced on users/{uid} (see above), not here. The mandatory
    // "a linked student can't open their own Business/Education profile"
    // rule lives in this create check.
    match /workspaces/{workspaceId} {
      // get() elsewhere (project creation, roster checks) bypasses this and
      // always succeeds regardless of who's asking — this only gates a
      // normal client read/list of the workspace doc itself.
      allow read: if request.auth != null && request.auth.uid == resource.data.ownerId;

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerId
        && request.resource.data.createdAt == request.time
        // .get(field, null) rather than .field — an older-shape profile doc
        // (created before this feature existed, e.g. any account signed up
        // before 2026-08-06) may not have this key at all, and plain dot
        // access throws instead of treating it as unset. This exact bug
        // shipped once already (denied every "Open Business/Education
        // profile" click for a pre-existing account) — see CLAUDE.md.
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('studentOfTeacherUid', null) == null
        && (
          (request.resource.data.type == 'business'
            && request.resource.data.keys().hasOnly(['type', 'ownerId', 'createdAt']))
          || (request.resource.data.type == 'education'
            && request.resource.data.keys().hasOnly(['type', 'ownerId', 'createdAt', 'teacherPin'])
            && request.resource.data.teacherPin.matches('^[0-9]{8}$'))
        );

      allow update, delete: if false;

      // The teacher's class roster. Doc ID = the student's own uid.
      match /students/{uid} {
        allow read: if request.auth != null
          && (request.auth.uid == uid
              || get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid);

        // Self-service: reaching this point already proved the student
        // knew the teacher's PIN (see teacherPins/{pin} below) — same
        // bearer-capability shape as invite tokens/usernames elsewhere.
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'username', 'displayName', 'joinedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.joinedAt == request.time;

        allow update: if false;

        // The teacher removing a student — this *is* "release" (paired
        // client-side with clearing studentOfTeacherUid/
        // studentOfWorkspaceId on the student's users/{uid} doc).
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
      }

      // The Business workspace's team roster. Doc ID = the member's own
      // uid. Unlike students (self-service via PIN), this is entirely
      // owner-driven — the owner adds/removes people directly, and only
      // an existing friend can be added (same requirement as
      // direct-add-to-project). This roster is purely a bulk-management
      // list, not itself an access grant: actual project access is still
      // just the ordinary projects/{id}/members/{uid} mechanism, written/
      // deleted client-side alongside roster changes — see CLAUDE.md.
      // $(workspaceId) is fixed for the whole query here (the client only
      // ever lists one already-known workspace's own team subcollection),
      // which is why this get() is safe for `list` — same reasoning as
      // students/{uid} above, unlike the projects/{id} list gotcha
      // documented below.
      match /team/{uid} {
        allow read: if request.auth != null
          && (request.auth.uid == uid
              || get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid);

        allow create: if request.auth != null
          && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid
          && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'business'
          && request.resource.data.keys().hasOnly(['uid', 'username', 'displayName', 'addedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.addedAt == request.time
          && isFriend(request.auth.uid, uid);

        allow update: if false;

        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
      }
    }

    // The doc ID *is* the 8-digit PIN — same "ID as the whole
    // access-control mechanism" pattern as usernames/invites. Permanent
    // (no update/delete — matches "always the same" by design) and
    // publicly readable by exact code (never listable), because a brand
    // new signup needs to resolve a PIN to a workspaceId before an account
    // — and therefore an auth token — exists yet. Accepted tradeoff: an
    // 8-digit numeric code is brute-forceable in principle (no
    // rate-limiting without a Cloud Function, which would hit the Blaze
    // wall again), the same security level as any classroom join code.
    match /teacherPins/{pin} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['workspaceId', 'teacherUid'])
        && request.resource.data.teacherUid == request.auth.uid
        && get(/databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)).data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)).data.type == 'education';

      allow update, delete: if false;
    }

    match /projects/{projectId} {
      // Only the owner creates a project. workspaceId scopes it to one of
      // the owner's workspaces (see CLAUDE.md > Security Principles) — for
      // the Personal workspace it's just the owner's own uid (no
      // workspaces/{id} doc exists for Personal at all); for
      // Business/Education it must point at a workspace the owner actually
      // owns.
      // linkedTeacherUid is a denormalized copy of the owner's
      // studentOfTeacherUid *at creation time* — see the read rule below
      // for why: get()-based checks (isTeacherOf) don't work for `list`
      // queries whose path depends on resource.data (Firestore can't prove
      // a list request "safe" when a get() call's path is built from a
      // per-candidate-document field — confirmed empirically: a single
      // get() by known project ID works fine, but a teacher's *query* for
      // "every project owned by this student" doesn't). This field keeps
      // that check to a plain resource.data comparison, which does work
      // for list. Kept in sync at release time (see members/{uid}-style
      // release comment on the update rule below) — until then it stays
      // fixed at whatever it was when the project was created, matching
      // studentOfTeacherUid only ever being set once, at signup.
      // visibleToTeam is always written explicitly (false on Personal/
      // Education projects too — they just never toggle it) — see the
      // Business "team" feature in CLAUDE.md > Security Principles. It's a
      // pure bulk-management flag: toggling it doesn't grant access by
      // itself, the client mirrors it into ordinary members/{uid} docs for
      // the current team roster, using the create/delete rules already
      // below — no new access-control logic needed here.
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerId
        && request.resource.data.keys().hasOnly(['name', 'category', 'ownerId', 'workspaceId', 'linkedTeacherUid', 'visibleToTeam', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.category == 'diy'
        && (request.resource.data.workspaceId == request.auth.uid
            || get(/databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)).data.ownerId == request.auth.uid)
        && request.resource.data.linkedTeacherUid == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('studentOfTeacherUid', null)
        && request.resource.data.visibleToTeam is bool
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Owner, members (redeemed collaborators), and — read-only — the
      // owner's Education teacher (if any, per linkedTeacherUid) can all
      // read the project. Only owner/members can update it (except the
      // one narrow release-time write below).
      //
      // Split into `get` vs `list` (rather than one combined `allow read`)
      // for the same reason `linkedTeacherUid` exists at all: confirmed
      // empirically, on both the emulator and the live project, that a
      // `list`/query request fails outright ("Null value error" on the
      // emulator, a clean permission-denied on prod) when the rule
      // contains an exists()/get() call whose path is built from
      // `$(projectId)` — a match-block path wildcard, not literally the
      // documented `{path=**}` collection-group case in CLAUDE.md, but the
      // same underlying "list-safety can't be proven" class of gotcha.
      // `get` (a single doc, fully-known ID) doesn't have this problem —
      // it keeps the members exists() check. `list` never needs it: the
      // app never lists `projects` filtered as a *member* (the dashboard's
      // "Shared with you" section queries the `members` collection group
      // instead, then does one `get` per project) — only as the owner
      // (dashboard's own project list, `resource.data.ownerId`) or as a
      // linked teacher (`resource.data.linkedTeacherUid`), both plain
      // resource.data comparisons and therefore list-safe.
      allow get: if request.auth != null
        && (request.auth.uid == resource.data.ownerId
            || exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid))
            || resource.data.get('linkedTeacherUid', null) == request.auth.uid);

      allow list: if request.auth != null
        && (request.auth.uid == resource.data.ownerId
            || resource.data.get('linkedTeacherUid', null) == request.auth.uid);

      allow update: if request.auth != null
        && (
          (request.auth.uid == resource.data.ownerId
              || exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)))
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.workspaceId == resource.data.workspaceId
            && request.resource.data.category == resource.data.category
            && request.resource.data.get('linkedTeacherUid', null) == resource.data.get('linkedTeacherUid', null)
            // Only the owner can flip visibleToTeam — a collaborator can
            // update other fields (e.g. steps live elsewhere, but nothing
            // stops a member renaming the project today) but not this one.
            && (request.resource.data.get('visibleToTeam', false) == resource.data.get('visibleToTeam', false)
                || request.auth.uid == resource.data.ownerId)
            && request.resource.data.updatedAt == request.time
          // The release-time cascade: the teacher currently denormalized
          // onto this project may clear (only) linkedTeacherUid — nothing
          // else — same shape as the studentOf* release clause on
          // users/{userId} above. Without this, an old project would keep
          // granting the now-released teacher read access forever, since
          // linkedTeacherUid otherwise never changes after creation.
          || (resource.data.get('linkedTeacherUid', null) == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedTeacherUid'])
            && request.resource.data.linkedTeacherUid == null)
        );

      // ...but only the owner can delete it.
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;

      match /steps/{stepId} {
        // Members can read/write as usual; the owner's teacher (if any)
        // gets read-only access here too, same as the parent project.
        allow read: if isProjectMember(projectId) || isTeacherOfProject(projectId);

        allow create: if isProjectMember(projectId)
          && request.resource.data.keys().hasOnly(
               ['title', 'notes', 'materials', 'tools', 'done', 'order', 'createdBy', 'createdAt', 'updatedAt'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.notes is string
          && request.resource.data.materials is list
          && request.resource.data.tools is list
          && request.resource.data.done == false
          && request.resource.data.order is number
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isProjectMember(projectId)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;

        // Only the project owner can delete a step.
        allow delete: if isProjectOwner(projectId);
      }

      // A single-use, expiring "ticket". The document ID *is* the random
      // token — that's the whole access-control mechanism: you can only
      // fetch/update one of these if you already know its exact ID, and
      // `allow read: if false` below means no one (not even the owner) can
      // list or browse this subcollection to discover tokens. Redemption is
      // just: flip redeemedBy from null to your own uid. Firestore
      // serializes concurrent writes to the same document, so only the
      // first person to attempt this update can ever succeed — that's what
      // makes it single-use without a server.
      match /invites/{token} {
        allow create: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId
          && request.resource.data.keys().hasOnly(['createdBy', 'expiresAt', 'redeemedBy', 'redeemedAt'])
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.expiresAt > request.time
          // Client computes expiresAt as its own Date.now() + 7d; comparing
          // against request.time (the server's clock) with no slack means
          // any clock skew or network latency between the two flips this
          // to permission-denied, so a few minutes of buffer are allowed.
          && request.resource.data.expiresAt < request.time + duration.value(7, 'd') + duration.value(10, 'm')
          && request.resource.data.redeemedBy == null
          && request.resource.data.redeemedAt == null;

        allow read: if false;

        allow update: if request.auth != null
          && resource.data.redeemedBy == null
          && resource.data.expiresAt > request.time
          && request.resource.data.redeemedBy == request.auth.uid
          && request.resource.data.redeemedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['redeemedBy', 'redeemedAt']);

        // Lets the owner clean up spent/expired invites; harmless since
        // it's their own project's data either way.
        allow delete: if isProjectOwner(projectId);
      }

      // Created only after successfully redeeming a matching invite above
      // (see the get() check below) — this is what actually grants
      // collaborator access via isProjectMember().
      match /members/{uid} {
        // Anyone can check their OWN membership doc (even if it doesn't
        // exist yet — that's how join.js detects "not a member yet" vs
        // "already joined"). Other members/the owner can see the full list.
        allow read: if request.auth != null
          && (request.auth.uid == uid || isProjectMember(projectId));

        // Two mutually-exclusive shapes: the invite-redemption path
        // (joining user proves a redeemed invite via `token`, unchanged
        // from before) or the friend-direct-add path (the project owner
        // adds someone from their own friends list, no invite involved —
        // `addedVia` instead of `token` keeps the two paths distinguishable
        // in the data itself). `displayName`/`username` are denormalized
        // (see CLAUDE.md) so the project page can show a readable
        // collaborators list without reading anyone's private users/{uid}.
        // viewWorkspaceId (invite-redemption path only) is the joiner's
        // own choice, made at accept-time in join.js, of which of THEIR
        // OWN workspace tabs this shared project should appear under —
        // it has nothing to do with the owner's workspace. Must be either
        // their own uid (Personal) or a workspace they've actually opened
        // themselves, so no one can claim a Business/Education tab they
        // don't have. The friend-direct-add path (owner adds someone
        // directly) never sets it — the owner doesn't know the
        // recipient's preference — so the client defaults a missing
        // value to Personal when rendering (see dashboard.js).
        allow create: if request.auth != null
          && request.resource.data.joinedAt == request.time
          && request.resource.data.displayName is string
          && request.resource.data.username is string
          && (
            (request.auth.uid == uid
              && request.resource.data.keys().hasOnly(['uid', 'token', 'displayName', 'username', 'joinedAt', 'viewWorkspaceId'])
              && request.resource.data.uid == request.auth.uid
              && get(/databases/$(database)/documents/projects/$(projectId)/invites/$(request.resource.data.token)).data.redeemedBy == request.auth.uid
              && (request.resource.data.viewWorkspaceId == request.auth.uid
                  || request.resource.data.viewWorkspaceId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessWorkspaceId', null)
                  || request.resource.data.viewWorkspaceId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('teacherWorkspaceId', null)))
            || (isProjectOwner(projectId)
              && request.resource.data.keys().hasOnly(['uid', 'addedVia', 'displayName', 'username', 'joinedAt'])
              && request.resource.data.uid == uid
              && request.resource.data.addedVia == 'friend'
              && isFriend(request.auth.uid, uid))
          );

        allow update: if false;

        // Owner-only removal — the "remove collaborator" feature.
        allow delete: if isProjectOwner(projectId);
      }
    }

    // Collection-group query support: the dashboard's "Shared with you"
    // list queries collectionGroup(db, "members") across every project.
    // Firestore's `list` rule resolution for collection-group queries does
    // NOT consider the nested match block above (that one only governs
    // get/create/etc. on a fully-known path) — it needs its own rule using
    // the {path=**} recursive wildcard. Scoped to `list` only (not `get`,
    // which the nested rule already covers) and to your own uid only, so
    // this can never be used to browse anyone else's membership.
    match /{path=**}/members/{uid} {
      allow list: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
